{
  "uid": "elixircd-storage",
  "title": "ElixIRCd | Storage & database",
  "description": "Data volume capacity and usage, Mnesia table sizes, and database transaction throughput and latency.",
  "tags": [
    "elixircd",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 5,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "ElixIRCd dashboards",
      "tags": [
        "elixircd"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 3,
      "title": "Data volume available",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "elixircd_data_available_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Data volume capacity",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "elixircd_data_capacity_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 15,
      "title": "Data volume used",
      "type": "stat",
      "description": "Calculated from capacity and available bytes. No data means disk capacity could not be read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - elixircd_data_available_bytes / elixircd_data_capacity_bytes)",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 16,
      "title": "Failed transactions since restart",
      "type": "stat",
      "description": "Observed Mnesia transaction failures since the current server process started.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(elixircd_database_transactions_total{result=\"failure\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 11,
      "title": "Largest Mnesia tables by rows",
      "type": "timeseries",
      "description": "Eight largest Mnesia tables by current row count. Table names are shortened in the legend.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "label_replace(topk(8, elixircd_table_rows), \"table_name\", \"$1\", \"table\", \".*[.]([^.]+)$\")",
          "refId": "A",
          "legendFormat": "{{table_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "title": "Data volume used over time",
      "type": "timeseries",
      "description": "Percent used on the server data volume. No data means disk capacity could not be read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - elixircd_data_available_bytes / elixircd_data_capacity_bytes)",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "Used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Transactions / second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(elixircd_database_transactions_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Transaction latency p95",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(elixircd_database_transaction_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "Transaction latency p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
