discovery.docker "elixircd" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.service=elixircd"]
  }
}

discovery.relabel "elixircd" {
  targets = discovery.docker.elixircd.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "elixircd-observability"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "elixircd" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.elixircd.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
